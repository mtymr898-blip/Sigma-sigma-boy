{
  "name": "sigma-sigma-boy",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",

  // فقط پوشه‌ی public/ عمومی منتشر می‌شود (نه ریشه‌ی پروژه)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "DashboardStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DashboardStore"] }],

  // نمونه‌برداری از ارزش پرتفو هر ۳۰ دقیقه (برای نمودار تاریخچه)
  "triggers": { "crons": ["*/30 * * * *"] },

  // متغیرهای غیرمحرمانه. Secrets (NOBITEX_TOKEN, DASHBOARD_PASSCODE, SESSION_SECRET) اینجا نیستند.
  "vars": {
    "TRADING_ENABLED": "false",          // سفارش واقعی به‌صورت پیش‌فرض خاموش
    "MAX_ORDER_VALUE_IRT": "1000000",    // سقف مبلغ هر سفارش (تومان)
    "PRICE_BAND_PCT": "20",              // حداکثر فاصله‌ی قیمت سفارش محدود از قیمت بازار
    "ALLOWED_ORIGINS": "https://localhost" // مبدأ برنامه‌ی Capacitor اندروید (CORS)
  }
}
